# Copy to .env (or export these however you like) before `npm start`.
# quotaspill.config.json references these by name via "env:VAR_NAME".

# A real, pay-as-you-go Anthropic Console API key. NOT the same thing as a
# Claude Pro/Max subscription login: the CLI's `claude login` flow does not
# produce one of these. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# A real OpenAI API key, if you're routing an OpenAI-compatible client.
OPENAI_API_KEY=

# The unified key from your freellmapi dashboard (Keys page), or any other
# OpenAI/Anthropic-compatible fallback endpoint's key.
FREELLMAPI_KEY=
